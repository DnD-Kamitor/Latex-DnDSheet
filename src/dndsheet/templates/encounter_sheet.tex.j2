\chapter*{Monster Stat Blocks}
\addcontentsline{toc}{chapter}{Monster Stat Blocks}

{% for monster in encounter.monsters %}
\begin{DndMonster}{ {{ monster.name }} }
    \DndMonsterType{ {{ monster.size }} {{ monster.type }}, {{ monster.alignment }} }
    \DndMonsterAC{ {{ monster.ac }} }
    \DndMonsterHP{ {{ monster.hp }} ({{ monster.hit_dice }}) }
    \DndMonsterSpeed{ {{ monster.speed }} }
    \DndMonsterStats{ {{ monster.strength }}, {{ monster.dexterity }}, {{ monster.constitution }}, {{ monster.intelligence }}, {{ monster.wisdom }}, {{ monster.charisma }} }
    \DndMonsterSkills{
        {% for skill, mod in monster.skills.items() %}
            {{ skill.value.replace("_", " ").title() }} {{ "%+d"|format(mod) }}{% if not loop.last %}, {% endif %}
        {% endfor %}
    }
    \DndMonsterSaves{
        {% for ability, mod in monster.saving_throws.items() %}
            {{ ability.value.capitalize() }} {{ "%+d"|format(mod) }}{% if not loop.last %}, {% endif %}
        {% endfor %}
    }
    \DndMonsterDamageVulnerabilities{ {{ monster.damage_vulnerabilities | join(", ") if monster.damage_vulnerabilities else "—" }} }
    \DndMonsterDamageResistances{ {{ monster.damage_resistances | join(", ") if monster.damage_resistances else "—" }} }
    \DndMonsterDamageImmunities{ {{ monster.damage_immunities | join(", ") if monster.damage_immunities else "—" }} }
    \DndMonsterConditionImmunities{ {{ monster.condition_immunities | join(", ") if monster.condition_immunities else "—" }} }
    \DndMonsterSenses{ {{ monster.senses }} }
    \DndMonsterLanguages{ {{ monster.languages }} }
    \DndMonsterCR{ {{ monster.cr }} ({{ monster.xp }} XP) }

    {% if monster.traits %}
    \DndMonsterTraits
        {% for trait in monster.traits %}
        \DndMonsterTrait{ {{ trait.name }}}{ {{ trait.desc }} }
        {% endfor %}
    {% endif %}

    \DndMonsterActions
        {% for action in monster.actions %}
        \DndMonsterAction{ {{ action.name }}}{ {{ action.desc }} }
        {% endfor %}
    
    {% if monster.legendary_actions %}
    \DndMonsterLegendaryActions
        {% for l_action in monster.legendary_actions %}
        \DndMonsterAction{ {{ l_action.name }}}{ {{ l_action.desc }} }
        {% endfor %}
    {% endif %}

\end{DndMonster}
\newpage
{% endfor %}

